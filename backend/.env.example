# Supabase / PostgreSQL connection string
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:yourpassword@db.yourproject.supabase.co:5432/postgres

# LLM: NVIDIA NIM API (Primary)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# Optional: Google Generative AI fallback
GOOGLE_API_KEY=your_google_api_key_here

# Sarvam AI (Ask FINVORA Agent)
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh

# FINVORA FastMCP Server HTTP Bearer Auth Token
MCP_SERVER_TOKEN=your_mcp_server_token_here

# ==================================
# OCR CONFIGURATION
# ==================================
OCR_ENGINE=paddleocr
PADDLE_OCR_LANG=en
PADDLE_OCR_USE_ANGLE_CLS=true
PADDLE_OCR_USE_GPU=false

# ==================================
# SAP S/4HANA & BTP INTEGRATION
# ==================================
# Set to true for live OData v2 connection; false runs in deterministic demonstration sandbox
SAP_ENABLED=false
SAP_BASE_URL=https://sandbox.api.sap.com/s4hanacloud

# Option 1: OAuth2 Client Credentials Grant (SAP BTP / S/4HANA Cloud)
SAP_CLIENT_ID=
SAP_CLIENT_SECRET=
SAP_TOKEN_URL=

# Option 2: API Key (SAP Business Accelerator Hub / API Management)
SAP_API_KEY=

# Option 3: Basic Authentication (SAP Communication User)
SAP_USERNAME=
SAP_PASSWORD=

# Canonical SAP S/4HANA OData v2 Service Paths (Customize if using custom communication arrangements)
# 1. Purchase Order: API_PURCHASEORDER_2
SAP_PO_SERVICE_PATH=/sap/opu/odata/sap/API_PURCHASEORDER_2
# 2. Supplier Invoice: API_SUPPLIERINVOICE_PROCESS_SRV_0001
SAP_INVOICE_SERVICE_PATH=/sap/opu/odata/sap/API_SUPPLIERINVOICE_PROCESS_SRV_0001
# 3. Material Document / Goods Receipt: API_MATERIAL_DOCUMENT
SAP_MATERIAL_SERVICE_PATH=/sap/opu/odata/sap/API_MATERIAL_DOCUMENT
# 4. Business Partner / Supplier Master: API_BUSINESS_PARTNER
SAP_BP_SERVICE_PATH=/sap/opu/odata/sap/API_BUSINESS_PARTNER

# ==================================
# WMS INTEGRATION
# ==================================
WMS_ENABLED=false
WMS_BASE_URL=
WMS_API_KEY=

# Treasury Cash Buffer Threshold (in INR, e.g. 1 Cr = 10000000.0)
MIN_CASH_BUFFER=10000000.0

# CORS — comma-separated allowed origins (e.g. your Vercel or production domain)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend.vercel.app

# Optional CORS regex for preview deployments (matches .vercel.app and .netlify.app by default)
ALLOWED_ORIGIN_REGEX=^https://.*(\.vercel\.app|\.netlify\.app)$
